# Copy this file to .env and fill in real values before running the app.
# Every NUXT_PUBLIC_* var here maps automatically to runtimeConfig.public.* in nuxt.config.ts.

# Public site URL — used in OG/canonical meta tags and i18n's baseUrl.
# Netlify production builds fail (see hooks['build:before'] in nuxt.config.ts) if this
# is left unset or still the template placeholder.
NUXT_PUBLIC_SITE_URL=https://www.yoursite.com
